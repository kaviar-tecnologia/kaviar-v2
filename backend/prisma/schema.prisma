  territory          operational_territories? @relation("territorial_dataset_versions_territory", fields: [territory_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([city, uf])
  @@index([status])
  @@index([provider_id])
  @@index([territory_id])
  @@index([uf, city, created_at(sort: Desc)])
  @@map("territorial_dataset_versions")
}

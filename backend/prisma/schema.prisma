generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum financial_recognition_subject {
  RIDE_REVENUE
  PREPAID_DRIVER_CREDITS
  MANAGER_PAYMENTS
  COMMERCIAL_PAYMENTS
  OTHER
}

enum financial_recognition_scope_type {
  GLOBAL
  TERRITORY
  CITY
  COST_CENTER
}

enum financial_recognition_policy {
  UNCLASSIFIED
  GROSS_PRINCIPAL
  NET_AGENT
}

enum financial_recognition_policy_status {
  DRAFT
  APPROVED
  SUPERSEDED
  REVOKED
}

enum financial_account_type {
  BANK
  CASH
  PIX_WALLET
  RECEIVABLE
  PAYABLE
  TAX
  CLEARING
  THIRD_PARTY
  INTERNAL
  ESCROW
}

enum accounting_nature_type {
  DEBIT
  CREDIT
}

enum financial_category_kind {
  REVENUE
  EXPENSE
  CONTRIBUTION
  WITHDRAWAL
  TRANSFER
  LIABILITY
  CLEARING
  ADJUSTMENT
}

enum financial_cost_center_type {
  COMPANY
  DEPARTMENT
  TERRITORY
  CITY
  PROJECT
  OTHER
}

enum financial_direction {
  IN
  OUT
}

enum financial_transaction_type {
  INCOME
  EXPENSE
  TRANSFER
  RECEIVABLE
  PAYABLE
  ADJUSTMENT
  REVERSAL
  REFUND
  RECONCILIATION
  ACCRUAL
  SETTLEMENT
  WITHDRAWAL
  DEPOSIT
  TAX
  FEE
  COMPENSATION
}

enum financial_transaction_status {
  DRAFT
  PENDING
  POSTED
  CANCELED
  REVERSED
  BLOCKED
  RECONCILED
  CLOSED
}

enum financial_payment_method {
  PIX
  ASAAS
  SUMUP
  BANK_TRANSFER
  TED
  DOC
  CASH
  CARD
  BOLETO
  INTERNAL
  NONE
}

enum financial_source_type {
  RIDE
  DRIVER_WALLET
  CREDIT_SALE
  TERRITORIAL_PAYOUT
  COMMERCIAL_ORDER
  MANUAL
  BANK_IMPORT
  BANK_WEBHOOK
  PAYMENT_PROVIDER
  NFSE
  ACCOUNTING
  REFUND
  TAX
  ADJUSTMENT
}

enum financial_origin_type {
  OPERATIONAL
  COMMERCIAL
  BANK
  PROVIDER
  MANUAL
  ACCOUNTING
  TAX
  INTERNAL
}

enum financial_transaction_allocation_type {
  SIMPLE
  ALLOCATED
  ADJUSTMENT
  RECLASSIFICATION
}

enum financial_transaction_link_type {
  SETTLEMENT
  TRANSFER_PAIR
  REVERSAL
  DOCUMENT_LINK
  RECONCILIATION
  COMPETENCE
  RATEIO
  ACCOUNTANT_REVIEW
}

model admins {
  id                          String              @id @default(uuid())
  name                        String
  email                       String              @unique
  password                    String
  phone                       String?
  role                        String              @default("SUPER_ADMIN")
  is_active                   Boolean             @default(true)
  must_change_password        Boolean             @default(true)
  password_changed_at         DateTime?
  marketing_followup_sent_at  DateTime?
  lead_regions                String?
  invite_code                 String?             @unique
  invite_code_expires_at      DateTime?
  sms_alerts_enabled          Boolean             @default(true)
  notify_new_drivers          Boolean             @default(true)
  notify_new_passengers       Boolean             @default(false)
  created_at                  DateTime            @default(now())
  updated_at                  DateTime            @updatedAt
  community_leaders           community_leaders[]
  territory_access            admin_territory_access[]
  operator_profile            operator_profiles?
  fee_configs_created         platform_fee_configs[]         @relation("fee_config_creator")
  fee_configs_approved        platform_fee_configs[]         @relation("fee_config_approver")
  manager_assignments         territory_manager_assignments[] @relation("tma_admin")
  manager_assignments_created territory_manager_assignments[] @relation("tma_creator")
  op_contract_reviews         operator_profiles[]             @relation("op_contract_reviewer")
  contract_submissions_sent   contract_submissions[]          @relation("cs_submitter")
  contract_submissions_reviewed contract_submissions[]        @relation("cs_reviewer")
  kaviar_group_posts_author   kaviar_group_posts[]            @relation("kaviar_group_posts_author_admin")
  insurance_coverages_created operational_insurance_coverages[] @relation("insurance_coverages_created_by")
  insurance_coverages_updated operational_insurance_coverages[] @relation("insurance_coverages_updated_by")
  municipal_authorizations_submitted_admin municipal_authorizations[] @relation("municipal_authorizations_submitted_by_admin")
  municipal_authorizations_submitted_manager municipal_authorizations[] @relation("municipal_authorizations_submitted_by_manager")
  municipal_authorizations_approved municipal_authorizations[] @relation("municipal_authorizations_approved_by_admin")
  municipal_package_audit_logs municipal_package_audit_logs[] @relation("municipal_package_audit_actor")
  email_send_logs             email_send_logs[]
  financial_accounts_created                 financial_accounts[]              @relation("financial_accounts_created_by")
  financial_accounts_updated                 financial_accounts[]              @relation("financial_accounts_updated_by")
  financial_categories_created               financial_categories[]            @relation("financial_categories_created_by")
  financial_categories_updated               financial_categories[]            @relation("financial_categories_updated_by")
  financial_cost_centers_created             financial_cost_centers[]          @relation("financial_cost_centers_created_by")
  financial_cost_centers_updated             financial_cost_centers[]          @relation("financial_cost_centers_updated_by")
  financial_recognition_policies_created     financial_recognition_policies[]  @relation("financial_recognition_policies_created_by")
  financial_recognition_policies_updated     financial_recognition_policies[]  @relation("financial_recognition_policies_updated_by")
  financial_recognition_policies_approved    financial_recognition_policies[]  @relation("financial_recognition_policies_approved_by")
  financial_transactions_created             financial_transactions[]           @relation("FinancialTransactionCreatedBy")
  financial_transactions_approved            financial_transactions[]           @relation("FinancialTransactionApprovedBy")
  financial_transactions_responsible         financial_transactions[]           @relation("FinancialTransactionResponsible")
  financial_transaction_allocations_created  financial_transaction_allocations[] @relation("FinancialTransactionAllocationCreatedBy")
  financial_transaction_links_created        financial_transaction_links[]      @relation("FinancialTransactionLinkCreatedBy")
  accountant_invites_created                 accountant_invites[]               @relation("invite_creator")
  accountant_invites_revoked                 accountant_invites[]               @relation("invite_revoker")
  accountant_links_created                   accountant_entity_links[]          @relation("link_creator")
  doc_files_uploaded                        accounting_company_document_files[] @relation("doc_file_uploader_admin")
  development_jobs_requested                 development_jobs[] @relation("development_job_requester")
  development_jobs_confirmed                 development_jobs[] @relation("development_job_confirmer")
}

model communities {
  id                       String                     @id
  name                     String
  description              String?
  is_active                Boolean                    @default(true)
  center_lat               Decimal?                   @db.Decimal(10, 8)
  center_lng               Decimal?                   @db.Decimal(11, 8)
  radius_meters            Int?
  geofence                 String?
  min_active_drivers       Int                        @default(3)
  deactivation_threshold   Int                        @default(1)
  auto_activation          Boolean                    @default(false)
  last_evaluated_at        DateTime?
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  community_geofences      community_geofences?
  community_leaders        community_leaders[]
  community_status_history community_status_history[]
  drivers                  drivers[]
  elderly_contracts        elderly_contracts[]
  passengers               passengers[]
  tourist_guides           tourist_guides[]
  local_support_drivers    local_support_drivers[] @relation("LocalSupportCommunity")
  local_support_invites    local_support_invites[] @relation("LocalSupportInviteCommunity")
}

model community_geofences {
  id           String                   @id
  community_id String                   @unique
  center_lat   Decimal                  @db.Decimal(10, 8)
  center_lng   Decimal                  @db.Decimal(11, 8)
  min_lat      Decimal?                 @db.Decimal(10, 8)
  min_lng      Decimal?                 @db.Decimal(11, 8)
  max_lat      Decimal?                 @db.Decimal(10, 8)
  max_lng      Decimal?                 @db.Decimal(11, 8)
  geojson      String?
  source       String
  source_ref   String?
  confidence   String
  is_verified  Boolean                  @default(false)
  review_notes String?
  created_at   DateTime                 @default(now())
  updated_at   DateTime
  geom         Unsupported("geometry")? // PostGIS native geometry(MultiPolygon, 4326)
  communities  communities              @relation(fields: [community_id], references: [id], onDelete: Cascade)

  @@index([geom], map: "community_geofences_geom_gist", type: Gist)
}

model community_status_history {
  id             String      @id
  community_id   String
  status         String
  from_is_active Boolean?
  to_is_active   Boolean?
  driver_count   Int?
  changed_by     String?
  reason         String?
  created_at     DateTime    @default(now())
  communities    communities @relation(fields: [community_id], references: [id])
}

model consents {
  id           String    @id
  user_id      String
  subject_type String?
  subject_id   String?
  type         String
  consent_type String?
  accepted     Boolean   @default(false)
  accepted_at  DateTime?
  ip_address   String?
  user_agent   String?
  created_at   DateTime  @default(now())

  @@unique([subject_type, subject_id, type], map: "consent_subject_type_subject_id_type_key")
  @@unique([user_id, type], map: "consent_user_id_type_key")
}

model diamond_audit_logs {
  id                 String   @id
  ride_id            String
  driver_id          String?
  action             String
  reason             String?
  bonus_amount       Decimal? @db.Decimal(10, 2)
  diamond_state_from String?
  diamond_state_to   String?
  details            Json?
  created_at         DateTime @default(now())
}

model driver_documents {
  id                   String    @id
  driver_id            String
  type                 String
  document_url         String    @default("")
  file_url             String?
  status               String    @default("pending")
  submitted_at         DateTime?
  verified_at          DateTime?
  verified_by_admin_id String?
  rejected_at          DateTime?
  rejected_by_admin_id String?
  reject_reason        String?
  created_at           DateTime  @default(now())
  updated_at           DateTime

  @@unique([driver_id, type], name: "driver_id_type", map: "driver_documents_driver_type_uniq")
}

model driver_enforcement_history {
  id         String   @id
  driver_id  String
  action     String
  reason     String?
  metadata   Json?
  admin_id   String
  created_at DateTime @default(now())
}

model driver_verifications {
  id                     String    @id
  driver_id              String    @unique
  community_id           String?
  status                 String    @default("pending")
  verified_at            DateTime?
  approved_at            DateTime?
  approved_by_admin_id   String?
  eligibility_checked_at DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime
}

model drivers {
  id                          String                        @id
  name                        String
  email                       String                        @unique
  password_hash               String?
  phone                       String?
  status                      String                        @default("pending")
  suspension_reason           String?
  suspended_at                DateTime?
  suspended_by                String?
  last_active_at              DateTime?
  neighborhood_id             String?
  community_id                String?
  document_cpf                String?
  document_rg                 String?
  document_cnh                String?
  vehicle_plate               String?
  vehicle_model               String?
  vehicle_color               String?
  vehicle_type                String   @default("CAR")
  banned_at                   DateTime?
  banned_reason               String?
  banned_by                   String?
  deleted_at                  DateTime?
  deleted_by                  String?
  last_location_updated_at    DateTime?
  last_lat                    Decimal?                      @db.Decimal(10, 8)
  last_lng                    Decimal?                      @db.Decimal(11, 8)
  virtual_fence_center_lat    Decimal?                      @db.Decimal(10, 8)
  virtual_fence_center_lng    Decimal?                      @db.Decimal(11, 8)
  secondary_base_lat          Decimal?                      @db.Decimal(10, 8)
  secondary_base_lng          Decimal?                      @db.Decimal(11, 8)
  secondary_base_label        String?
  secondary_base_enabled      Boolean                       @default(false)
  available                   Boolean?                      @default(true)
  available_updated_at        DateTime?
  is_premium                  Boolean                       @default(false)
  premium_override            Boolean?
  certidao_nada_consta_url    String?
  pix_key                     String?
  pix_key_type                String?
  // @deprecated 2026-07-27 — Aceite legado removido. Campo mantido para compatibilidade.
  // Não ler/escrever no código. Remoção física somente após período de compatibilidade,
  // auditoria de uso e migration específica aprovada.
  family_bonus_accepted       Boolean?                      @default(false)
  // @deprecated 2026-07-27 — Perfil legado removido. Campo mantido para compatibilidade.
  // Não ler/escrever no código. Remoção física somente após período de compatibilidade,
  // auditoria de uso e migration específica aprovada.
  family_bonus_profile        String?                       @default("individual")
  approved_at                 DateTime?
  approved_by                 String?
  rejected_at                 DateTime?
  rejected_by                 String?
  rejected_reason             String?
  pending_reason              String?
  pending_reason_updated_at   DateTime?
  territory_type              String?
  territory_verified_at       DateTime?
  territory_verification_method String?
  active_since                DateTime?
  password_changed_at         DateTime?
  active_session_id           String?
  device_id                   String?
  device_model                String?
  phone_verified_at           DateTime?
  last_reactivation_sent_at   DateTime?
  photo_url                   String?
  expo_push_token             String?                       @db.VarChar(100)
  fcm_push_token              String?                       @db.VarChar(200)
  push_token_updated_at       DateTime?
  premium_tourism_status      String                        @default("standard")
  premium_tourism_promoted_at DateTime?
  created_at                  DateTime                      @default(now())
  updated_at                  DateTime
  driver_compliance_documents driver_compliance_documents[]
  badge_events              driver_badge_events[]
  driver_consents             driver_consents?
  driver_modalities           driver_modalities[]
  driver_badges               driver_badges[]
  driver_territory_stats      driver_territory_stats[]
  communities                 communities?                  @relation(fields: [community_id], references: [id])
  neighborhoods               neighborhoods?                @relation(fields: [neighborhood_id], references: [id])
  match_logs                  match_logs[]
  rides                       rides[]
  rides_v2                    rides_v2[]                    @relation("DriverRidesV2")
  ride_offers                 ride_offers[]
  credit_purchases            driver_credit_purchases[]
  driver_status               driver_status?
  driver_location             driver_locations?
  territorial_partner_id        String?
  territorial_partner_linked_at DateTime?
  territorial_partner           territorial_partners? @relation(fields: [territorial_partner_id], references: [id])
  local_support_profile       local_support_drivers? @relation("LocalSupportDriver")
  fixed_routes                driver_fixed_routes[]
  municipal_authorizations    municipal_authorizations[]
  municipal_package_audit_logs municipal_package_audit_logs[]
  municipal_regulatory_driver_protocols municipal_regulatory_driver_protocols[]

  // Women matching preference
  women_matching_opt_in              Boolean   @default(false)
  women_matching_opted_in_at         DateTime? @db.Timestamptz
  women_matching_opted_out_at        DateTime? @db.Timestamptz
  women_matching_consent_version     String?

  // Women preference eligibility
  women_preference_eligible              Boolean   @default(false)
  women_preference_eligible_at           DateTime? @db.Timestamptz
  women_preference_eligibility_source    String?
  women_preference_eligibility_revoked_at DateTime? @db.Timestamptz

  @@index([territory_type])
  @@index([neighborhood_id, territory_type])
  @@index([status])
  @@index([last_location_updated_at])
  @@index([active_since])
  @@index([premium_tourism_status])
  @@index([territorial_partner_id])
  shadow_results               wallet_shadow_results[]

  // Wallet V2
  wallet_v2                    driver_wallets?
  wallet_v2_ledger             wallet_ledger[]
  wallet_v2_recharges          wallet_recharges[]
  wallet_v2_pending_debits     pending_debits[]
  referral_reward              driver_referral_rewards?
  annual_incentive_ledger      annual_incentive_ledger[]
  payout_destinations          driver_payout_destinations[]
  annual_incentive_requests    annual_incentive_requests[]
  annual_incentive_payouts     annual_incentive_payouts[]
}

model elderly_contracts {
  id                 String           @id
  elderly_profile_id String
  responsible_id     String?
  community_id       String
  status             String           @default("ACTIVE")
  service_type       String           @default("ACOMPANHAMENTO_ATIVO")
  starts_at          DateTime
  ends_at            DateTime?
  notes              String?
  created_at         DateTime         @default(now())
  updated_at         DateTime
  communities        communities      @relation(fields: [community_id], references: [id])
  elderly_profiles   elderly_profiles @relation(fields: [elderly_profile_id], references: [id], onDelete: Cascade)
  passengers         passengers?      @relation(fields: [responsible_id], references: [id])
}

model elderly_profiles {
  id                String              @id
  passenger_id      String              @unique
  emergency_contact String?
  emergency_phone   String?
  medical_notes     String?
  careLevel         String              @default("basic")
  created_at        DateTime            @default(now())
  updated_at        DateTime
  elderly_contracts elderly_contracts[]
  passengers        passengers          @relation(fields: [passenger_id], references: [id], onDelete: Cascade)
}

model neighborhood_geofences {
  id              String                   @id
  neighborhood_id String                   @unique
  geofence_type   String
  coordinates     Json
  source          String?
  source_url      String?
  area            Decimal?                 @db.Decimal(15, 6)
  perimeter       Decimal?                 @db.Decimal(15, 6)
  created_at      DateTime                 @default(now())
  updated_at      DateTime
  geom            Unsupported("geometry")?
  neighborhoods   neighborhoods            @relation(fields: [neighborhood_id], references: [id], onDelete: Cascade)

  @@index([geom], map: "idx_neighborhood_geofences_geom", type: Gist)
}

model neighborhoods {
  id                     String                  @id
  name                   String
  city                   String                  @default("Rio de Janeiro")
  description            String?
  zone                   String?
  administrative_region  String?
  is_active              Boolean                 @default(true)
  center_lat             Decimal?                @db.Decimal(10, 8)
  center_lng             Decimal?                @db.Decimal(11, 8)
  is_verified            Boolean                 @default(false)
  verified_at            DateTime?
  verified_by            String?
  created_at             DateTime                @default(now())
  updated_at             DateTime
  area_type              String?                 @default("BAIRRO_OFICIAL") @db.VarChar(50)
  parent_neighborhood_id String?
  population             Int?
  area_km2               Decimal?                @db.Decimal(10, 2)
  territory_id           String?
  community_leaders      community_leaders[]
  drivers                drivers[]
  match_logs             match_logs[]
  neighborhood_geofences neighborhood_geofences?
  passengers             passengers[]
  rides_pickup           rides[]                 @relation("pickup_neighborhood")
  rides_dropoff          rides[]                 @relation("dropoff_neighborhood")
  rides_v2_origin        rides_v2[]              @relation("RideOriginV2")
  rides_v2_dest          rides_v2[]              @relation("RideDestV2")
  territory              operational_territories? @relation(fields: [territory_id], references: [id])
  lab_snapshots          lab_maturity_snapshots[] @relation("LabSnapshots")

  @@unique([name, city])
  @@index([city])
  @@index([area_type], map: "idx_neighborhoods_area_type")
  @@index([city, area_type], map: "idx_neighborhoods_city_type")
  @@index([parent_neighborhood_id], map: "idx_neighborhoods_parent")
  @@index([territory_id], map: "idx_neighborhoods_territory")
}

model community_leaders {
  id                  String         @id @default(uuid())
  name                String
  email               String         @unique
  phone               String?
  neighborhood_id     String?
  community_id        String?
  leader_type         String
  verification_status String         @default("PENDING")
  verification_notes  String?
  verified_by         String?
  verified_at         DateTime?
  is_active           Boolean        @default(true)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  community           communities?   @relation(fields: [community_id], references: [id])
  neighborhood        neighborhoods? @relation(fields: [neighborhood_id], references: [id])
  admin               admins?        @relation(fields: [verified_by], references: [id])

  @@index([neighborhood_id])
  @@index([community_id])
  @@index([verification_status])
}

model passengers {
  id                          String                        @id
  name                        String
  email                       String                        @unique
  password_hash               String?
  phone                       String?
  document_cpf                String?
  neighborhood_id             String?
  community_id                String?
  status                      String                        @default("pending")
  password_changed_at         DateTime?
  phone_verified_at           DateTime?
  last_lat                    Decimal?                      @db.Decimal(10, 8)
  last_lng                    Decimal?                      @db.Decimal(11, 8)
  last_location_updated_at    DateTime?
  expo_push_token             String?                       @db.VarChar(100)
  fcm_push_token              String?                       @db.VarChar(200)
  push_token_updated_at       DateTime?
  created_at                  DateTime                      @default(now())
  updated_at                  DateTime
  elderly_contracts           elderly_contracts[]
  elderly_profiles            elderly_profiles?
  match_logs                  match_logs[]
  communities                 communities?                  @relation(fields: [community_id], references: [id])
  neighborhoods               neighborhoods?                @relation(fields: [neighborhood_id], references: [id])
  passenger_favorite_locations passenger_favorite_locations[]
  ride_confirmations          ride_confirmations[]
  rides                       rides[]
  rides_v2                    rides_v2[]                    @relation("PassengerRidesV2")
  tour_bookings               tour_bookings[]
  user_consents               user_consents[]
  fixed_route_reservations    driver_fixed_route_reservations[]

  // Women matching preference
  women_matching_opt_in              Boolean   @default(false)
  prefer_woman_driver_default        Boolean   @default(false)
  women_matching_opted_in_at         DateTime? @db.Timestamptz
  women_matching_opted_out_at        DateTime? @db.Timestamptz
  women_matching_consent_version     String?

  // Women preference eligibility
  women_preference_eligible              Boolean   @default(false)
  women_preference_eligible_at           DateTime? @db.Timestamptz
  women_preference_eligibility_source    String?
  women_preference_eligibility_revoked_at DateTime? @db.Timestamptz
}

model passenger_favorite_locations {
  id           String     @id @default(uuid())
  passenger_id String
  label        String
  type         String     // HOME, WORK, OTHER
  lat          Decimal    @db.Decimal(10, 8)
  lng          Decimal    @db.Decimal(11, 8)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  passengers   passengers @relation(fields: [passenger_id], references: [id], onDelete: Cascade)

  @@index([passenger_id])
}

model phone_challenges {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String    @db.VarChar(20)
  user_type    String    @db.VarChar(20)
  user_id      String?   @db.VarChar(255)
  purpose      String    @db.VarChar(30)
  code_hash    String    @db.VarChar(255)
  expires_at   DateTime
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  used_at      DateTime?
  created_at   DateTime  @default(now())

  @@index([phone, purpose, created_at(sort: Desc)], map: "idx_phone_challenges_lookup")
  @@index([user_id, user_type], map: "idx_phone_challenges_user")
}

model feature_flags {
  key                 String   @id @db.VarChar(100)
  enabled             Boolean  @default(false)
  rollout_percentage  Int      @default(0)
  updated_by_admin_id String?
  updated_at          DateTime @default(now())
  created_at          DateTime @default(now())
}

model feature_flag_allowlist {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String   @db.VarChar(100)
  passenger_id        String
  created_by_admin_id String?
  created_at          DateTime @default(now())


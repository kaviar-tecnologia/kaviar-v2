// territory_payout_cycles — see below (Marco 3.2A expanded version)

// ─── Territory Payout Cycles (Marco 3.2A) ─────────────────────────────────────

model territory_payout_cycles {
  id                              String    @id @default(dbgenerated("gen_random_uuid()"))
  territory_id                    String
  manager_id                      String?
  reference_month                 String
  policy_version                  String
  commission_rate_basis_points    Int       @default(4000)
  platform_fee_rate_basis_points  Int       @default(1800)
  competence_timezone             String    @default("America/Sao_Paulo")
  cycle_type                      String    @default("REGULAR")
  parent_cycle_id                 String?
  sequence_number                 Int       @default(1)
  gross_platform_fee_cents        BigInt    @default(0)
  gross_manager_commission_cents  BigInt    @default(0)
  approved_adjustments_cents      BigInt    @default(0)
  approved_amount_cents           BigInt    @default(0)
  status                          String    @default("OPEN")
  fiscal_document_required        Boolean   @default(false)
  fiscal_document_type            String?
  fiscal_document_status          String?   @default("NOT_REQUIRED")
  fiscal_document_reference       String?
  fiscal_document_url             String?
  calculated_at                   DateTime? @db.Timestamptz
  recognized_at                   DateTime? @db.Timestamptz
  submitted_for_review_at         DateTime? @db.Timestamptz
  approved_at                     DateTime? @db.Timestamptz
  approved_by                     String?
  cancelled_at                    DateTime? @db.Timestamptz
  cancelled_by                    String?
  cancel_reason                   String?

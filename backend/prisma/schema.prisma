// ═══════════════════════════════════════════════════════════════════
// Outbound Payment Infrastructure (Marco 3.1)
// ═══════════════════════════════════════════════════════════════════

model financial_payees {
  id                     String    @id @default(dbgenerated("gen_random_uuid()::text"))
  payee_type             String
  reference_id           String?
  legal_name_encrypted   String
  cpf_cnpj_encrypted     String
  cpf_cnpj_hmac          String
  cpf_cnpj_masked        String
  document_type          String
  status                 String    @default("PENDING_VERIFICATION")
  verification_status    String    @default("PENDING")
  risk_status            String    @default("NORMAL")
  encryption_key_version String    @default("1")
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @db.Timestamptz
  disabled_at            DateTime? @db.Timestamptz

  destinations           financial_payee_destinations[]
  obligations            financial_obligations[]
  payouts                financial_payouts[]
  recurring              financial_recurring_obligations[]

  @@index([payee_type])
  @@index([status])
  @@index([cpf_cnpj_hmac])
  @@index([reference_id])
}

model financial_payee_destinations {
  id                     String    @id @default(dbgenerated("gen_random_uuid()::text"))
  payee_id               String
  method                 String
  key_type               String?
  key_encrypted          String
  key_hmac               String
  key_masked             String
  encryption_key_version String    @default("1")
  status                 String    @default("active")
  verified_at            DateTime? @db.Timestamptz
  cooldown_until         DateTime? @db.Timestamptz
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @db.Timestamptz
  superseded_at          DateTime? @db.Timestamptz

  payee                  financial_payees @relation(fields: [payee_id], references: [id], onDelete: Restrict)

  @@index([payee_id])
}

model financial_obligations {
  id                             String    @id @default(dbgenerated("gen_random_uuid()::text"))
  payee_id                       String
  purpose                        String
  source_type                    String
  source_id                      String?
  description_safe               String
  gross_amount_cents             BigInt
  discount_amount_cents          BigInt    @default(0)
  net_amount_cents               BigInt
  due_date                       DateTime? @db.Date
  competence_date                DateTime? @db.Date
  status                         String    @default("DRAFT")
  recurring_schedule_id          String?
  document_reference             String?
  destination_snapshot_encrypted String?
  destination_hmac               String?
  destination_masked             String?
  idempotency_key                String    @unique
  correlation_id                 String    @default(dbgenerated("gen_random_uuid()::text"))
  created_by_system              Boolean   @default(false)
  created_by_admin_id            String?
  approved_by_admin_id           String?
  approved_at                    DateTime? @db.Timestamptz
  failure_code                   String?
  failure_message_safe           String?
  deadline_at                    DateTime? @db.Timestamptz
  created_at                     DateTime  @default(now()) @db.Timestamptz
  updated_at                     DateTime  @default(now()) @db.Timestamptz

  payee                          financial_payees @relation(fields: [payee_id], references: [id], onDelete: Restrict)
  allocations                    financial_obligation_allocations[]
  payouts                        financial_payouts[]
  outbox                         financial_payout_outbox[]

  @@index([payee_id])
  @@index([purpose])
  @@index([status])
  @@index([due_date])
  @@index([source_type, source_id])
}

model financial_obligation_allocations {
  id             String   @id @default(dbgenerated("gen_random_uuid()::text"))
  obligation_id  String
  source_type    String
  source_id      String
  amount_cents   BigInt
  metadata       Json     @default("{}") @db.JsonB
  created_at     DateTime @default(now()) @db.Timestamptz

  obligation     financial_obligations @relation(fields: [obligation_id], references: [id], onDelete: Restrict)

  @@index([obligation_id])
}

model financial_payouts {
  id                     String    @id @default(dbgenerated("gen_random_uuid()::text"))
  obligation_id          String
  payee_id               String
  amount_cents           BigInt
  instrument             String
  provider_name          String
  provider_payout_id     String?
  external_reference     String    @unique
  status                 String    @default("PENDING")
  provider_status        String?
  provider_response_safe Json?     @db.JsonB
  fee_cents              BigInt?
  submitted_at           DateTime? @db.Timestamptz
  confirmed_at           DateTime? @db.Timestamptz
  failed_at              DateTime? @db.Timestamptz
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @db.Timestamptz

  obligation             financial_obligations @relation(fields: [obligation_id], references: [id], onDelete: Restrict)
  payee                  financial_payees @relation(fields: [payee_id], references: [id], onDelete: Restrict)
  attempts               financial_payout_attempts[]

  @@index([obligation_id])
  @@index([status])
}

model financial_payout_attempts {
  id                     String    @id @default(dbgenerated("gen_random_uuid()::text"))
  payout_id              String
  attempt_number         Int
  status                 String
  error_code             String?
  error_safe             String?
  provider_response_safe Json?     @db.JsonB
  started_at             DateTime  @default(now()) @db.Timestamptz
  finished_at            DateTime? @db.Timestamptz
  next_retry_at          DateTime? @db.Timestamptz
  created_at             DateTime  @default(now()) @db.Timestamptz

  payout                 financial_payouts @relation(fields: [payout_id], references: [id], onDelete: Restrict)

  @@index([payout_id])
}

model financial_payout_outbox {
  id             String    @id @default(dbgenerated("gen_random_uuid()::text"))
  obligation_id  String    @unique
  payee_id       String
  purpose        String
  status         String    @default("PENDING")
  priority       Int       @default(0)
  locked_at      DateTime? @db.Timestamptz
  locked_by      String?
  attempts       Int       @default(0)
  next_at        DateTime  @default(now()) @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @default(now()) @db.Timestamptz

  obligation     financial_obligations @relation(fields: [obligation_id], references: [id], onDelete: Restrict)

  @@index([status, next_at])
}

model financial_provider_events {
  id                  String    @id @default(dbgenerated("gen_random_uuid()::text"))
  provider_name       String
  provider_event_id   String
  event_category      String
  event_type          String
  payout_id           String?
  payload_safe        Json      @default("{}") @db.JsonB
  processed           Boolean   @default(false)
  processed_at        DateTime? @db.Timestamptz
  processing_status   String    @default("PENDING")
  processing_attempts Int       @default(0)
  next_processing_at  DateTime  @default(now()) @db.Timestamptz
  processing_error_safe String?
  created_at          DateTime  @default(now()) @db.Timestamptz

  @@unique([provider_name, provider_event_id])
  @@index([payout_id])
  @@index([processing_status, next_processing_at])
}

model financial_recurring_obligations {
  id                         String    @id @default(dbgenerated("gen_random_uuid()::text"))
  payee_id                   String
  purpose                    String
  description_safe           String
  frequency                  String
  expected_amount_cents      BigInt
  amount_tolerance_cents     BigInt    @default(0)
  due_day                    Int?
  start_date                 DateTime  @db.Date
  end_date                   DateTime? @db.Date
  active                     Boolean   @default(true)
  requires_document          Boolean   @default(true)
  automatic_approval_allowed Boolean   @default(false)
  last_generated_competence  DateTime? @db.Date
  created_at                 DateTime  @default(now()) @db.Timestamptz
  updated_at                 DateTime  @default(now()) @db.Timestamptz

  payee                      financial_payees @relation(fields: [payee_id], references: [id], onDelete: Restrict)

  @@index([payee_id])
  @@index([active])
}

model financial_payment_audit {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  entity_type  String
  entity_id    String
  action       String
  admin_id     String?
  system_actor String?
  details_safe Json     @default("{}") @db.JsonB
  ip_address   String?
  created_at   DateTime @default(now()) @db.Timestamptz

  @@index([entity_type, entity_id])
  @@index([admin_id])
  @@index([created_at(sort: Desc)])

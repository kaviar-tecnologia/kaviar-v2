  @@index([community_id, invited_at(sort: Desc)])
}

// ─── Associações / Operadores Locais ───
model local_operators {
  id                    String    @id @default(uuid())
  organization_name     String
  responsible_name      String
  responsible_role      String    // presidente, liderança, vereador, representante
  phone                 String?
  email                 String?
  address               String?
  website               String?
  community             String?
  neighborhood          String?
  city                  String?
  source                String    @default("site")
  status                String    @default("researching")
  verified              Boolean   @default(false)
  notes                 String?
  next_followup_at      DateTime?
  drivers_referred      Int       @default(0)
  drivers_approved      Int       @default(0)
  first_contact_at      DateTime  @default(now())
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@index([status])
  @@index([city])
}

// ─── Parceiros Territoriais KAVIAR ──────────────────────────────────────────
model territorial_partners {
  id                  String   @id @default(uuid())
  name                String
  partner_type        String   @default("association") // association | condominium | business | community_leader | institution | other
  address             String?
  responsible_name    String
  responsible_role    String   @default("presidente")
  responsible_phone   String?
  responsible_email   String?
  commission_percent  Decimal  @default(5) @db.Decimal(5, 2)
  monthly_fee_cents   Int?
  billing_due_day     Int?     // dia do mês para vencimento (1-28)
  billing_status      String   @default("current") // current | pending | overdue | blocked | canceled
  last_payment_at     DateTime?
  referral_code       String?  @unique
  public_token        String?  @unique
  plan                String   @default("basic") // basic | management
  logo_url            String?
  status              String   @default("active") // active | paused | inactive
  notes               String?
  contract_status     String   @default("pending") // pending | signed | not_required
  contract_url        String?
  contract_signed_at  DateTime?
  contract_notes      String?
  territory_id        String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  drivers             drivers[]
  commissions         partner_commissions[]
  payments            partner_payments[]
  link_requests       partner_link_requests[]
  members             partner_members[]
  transactions        partner_transactions[]
  users               partner_users[]
  member_payments     partner_member_payments[]
  territory           operational_territories? @relation(fields: [territory_id], references: [id])

  @@index([status])
  @@index([partner_type])
  @@index([billing_status])
  @@index([territory_id], map: "idx_territorial_partners_territory")
}

model partner_commissions {
  id                 String   @id @default(uuid())
  partner_id         String
  ride_id            String
  driver_id          String
  ride_final_price   Decimal  @db.Decimal(8, 2)
  commission_percent Decimal  @db.Decimal(5, 2)
  commission_amount  Decimal  @db.Decimal(8, 2)
  status             String   @default("pending") // pending | paid | canceled
  paid_at            DateTime?
  paid_by            String?
  created_at         DateTime @default(now())

  partner            territorial_partners @relation(fields: [partner_id], references: [id])

  @@unique([ride_id, partner_id])
  @@index([partner_id, status])
  @@index([driver_id])
}

model partner_payments {
  id              String   @id @default(uuid())
  partner_id      String
  amount_cents    Int
  reference_month String?  // "2026-05" formato YYYY-MM
  paid_at         DateTime
  receipt_url     String?
  notes           String?
  registered_by   String   // admin_id
  created_at      DateTime @default(now())

  partner         territorial_partners @relation(fields: [partner_id], references: [id])

  @@index([partner_id, paid_at(sort: Desc)])
}

model partner_link_requests {
  id          String   @id @default(uuid())
  partner_id  String
  driver_id   String
  status      String   @default("pending") // pending | approved | rejected
  source      String   @default("referral_code") // referral_code | admin_manual | partner_invite
  reviewed_at DateTime?
  reviewed_by String?
  created_at  DateTime @default(now())

  partner     territorial_partners @relation(fields: [partner_id], references: [id])

  @@unique([partner_id, driver_id])
  @@index([partner_id, status])
  @@index([status])
}

model partner_members {
  id          String   @id @default(uuid())
  partner_id  String
  name        String
  unit        String?  // apt 101, casa 3, etc
  status      String   @default("active") // active | inactive
  created_at  DateTime @default(now())

  partner     territorial_partners @relation(fields: [partner_id], references: [id])
  payments    partner_member_payments[]

  @@index([partner_id, status])
}

model partner_member_payments {
  id              String    @id @default(uuid())
  partner_id      String
  member_id       String
  reference_month String
  amount_cents    Int
  payment_method  String    @default("pix") // pix | dinheiro | transferencia | cartao | outro
  paid_at         DateTime  @default(now())
  receipt_code    String    @unique
  notes           String?
  registered_by   String
  whatsapp_sent_at DateTime?
  created_at      DateTime  @default(now())

  partner  territorial_partners @relation(fields: [partner_id], references: [id])
  member   partner_members      @relation(fields: [member_id], references: [id])

  @@index([partner_id, reference_month])
  @@index([member_id])
}

model partner_transactions {
  id              String   @id @default(uuid())
  partner_id      String
  type            String   // income | expense
  amount_cents    Int
  description     String
  category        String   @default("outro") // mensalidade | manutencao | limpeza | evento | outro
  reference_month String?  // 2026-05
  member_id       String?
  created_at      DateTime @default(now())

  partner         territorial_partners @relation(fields: [partner_id], references: [id])

  @@index([partner_id, reference_month])
  @@index([partner_id, type])
}

model partner_users {
  id            String   @id @default(uuid())
  partner_id    String
  name          String
  email         String   @unique
  password_hash String
  is_active     Boolean  @default(true)
  last_login_at DateTime?
  created_at    DateTime @default(now())

  partner         territorial_partners      @relation(fields: [partner_id], references: [id])
  password_resets partner_password_resets[]

  @@index([partner_id])
}

model partner_password_resets {
  id              String    @id @default(uuid())
  partner_user_id String
  code_hash       String
  expires_at      DateTime
  used_at         DateTime?
  created_at      DateTime  @default(now())
  request_ip      String?
  user_agent      String?

  user partner_users @relation(fields: [partner_user_id], references: [id], onDelete: Cascade)

  @@index([partner_user_id])
  @@index([expires_at])
}

model private_ride_requests {
  id                  String   @id @default(uuid())
  name                String
  phone               String
  service_type        String   @default("outro") // consulta | mercado | escola | aeroporto | evento | idoso | compromisso | outro
  scheduled_date      String   // 2026-05-15
  scheduled_time      String   // 14:00
  origin              String
  destination         String
  round_trip          Boolean  @default(false)
  wait_at_destination Boolean  @default(false)
  notes               String?
  status              String   @default("new") // new | analyzing | confirmed | completed | canceled
  assigned_driver     String?
  admin_notes         String?
  partner_id          String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([scheduled_date])
  @@index([partner_id])
}

model local_businesses {
  id            String   @id @default(uuid())
  name          String
  category      String   @default("outro")
  description   String?
  whatsapp      String?
  address       String?
  logo_url      String?
  region_slug   String
  territory_id  String?  @db.Uuid
  partner_id    String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  @@index([region_slug, is_active])
  @@index([territory_id, is_active])
}

// ─── Territórios Operacionais (Multioperação) ────────────────────────────────
model operational_territories {
  id         String   @id @default(uuid())
  name       String
  level      String   // "country" | "state" | "city" | "region" | "operation"
  status     String   @default("active") // "planning" | "preparation" | "active" | "inactive"
  parent_id  String?
  uf         String?  // sigla do estado: RJ, SP, MG
  city_name  String?
  center_lat Decimal? @db.Decimal(10, 8)
  center_lng Decimal? @db.Decimal(11, 8)
  notes      String?
  regulatory_status     String   @default("not_evaluated")
  regulatory_notes      String?
  regulatory_checked_at DateTime?
  regulatory_checked_by String?

  // Cobertura territorial da cidade:
  // NOT_LOADED | AWAITING_REVIEW | COMPLETE
  coverage_status      String    @default("NOT_LOADED")
  coverage_reviewed_at DateTime?
  coverage_reviewed_by String?
  coverage_notes       String?

  is_active  Boolean  @default(true)
  moto_express_enabled Boolean @default(false)
  moto_passenger_enabled Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   operational_territories?  @relation("TerritoryHierarchy", fields: [parent_id], references: [id])
  children operational_territories[] @relation("TerritoryHierarchy")

  neighborhoods        neighborhoods[]
  territorial_partners territorial_partners[]
  admin_access         admin_territory_access[]
  finance_rules        territory_finance_rules[]
  operator_profiles    operator_profiles[]
  payouts              territory_payouts[]
  manager_assignments  territory_manager_assignments[]
  shadow_results       wallet_shadow_results[]
  moto_compliance      moto_passenger_compliance?
  insurance_coverages  operational_insurance_coverages[]
  financial_cost_centers         financial_cost_centers[]          @relation("financial_cost_centers_territory")
  financial_recognition_policies financial_recognition_policies[]  @relation("financial_recognition_policies_territory")
  territorial_dataset_versions   territorial_dataset_versions[]    @relation("territorial_dataset_versions_territory")

  @@unique([name, level, parent_id])
  @@index([level])
  @@index([status])
  @@index([parent_id])
}

model financial_recognition_policies {
  id                   String                              @id @default(uuid())
  code                 String
  subject              financial_recognition_subject
  scope_type           financial_recognition_scope_type
  territory_id         String?
  cost_center_id       String?
  city                 String?
  state                String?
  policy               financial_recognition_policy
  status               financial_recognition_policy_status
  effective_from       DateTime
  effective_until      DateTime?
  approved_by_admin_id String?
  approved_at          DateTime?
  reason               String
  notes                String?
  created_by_admin_id  String?
  updated_by_admin_id  String?
  created_at           DateTime                            @default(now())
  updated_at           DateTime                            @updatedAt

  territory         operational_territories? @relation("financial_recognition_policies_territory", fields: [territory_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cost_center       financial_cost_centers?  @relation("financial_recognition_policies_cost_center", fields: [cost_center_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approved_by_admin admins?                  @relation("financial_recognition_policies_approved_by", fields: [approved_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  created_by_admin  admins?                  @relation("financial_recognition_policies_created_by", fields: [created_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updated_by_admin  admins?                  @relation("financial_recognition_policies_updated_by", fields: [updated_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([code])
  @@index([subject, scope_type, status], map: "financial_recognition_policies_subject_scope_status_idx")
  @@index([territory_id])
  @@index([cost_center_id])
  @@index([effective_from, effective_until], map: "financial_recognition_policies_effective_from_effective_until_i")
  @@map("financial_recognition_policies")
}

model financial_accounts {
  id                       String                 @id @default(uuid())
  code                     String
  name                     String
  type                     financial_account_type
  institution_name         String?
  bank_code                String?
  agency_encrypted         String?
  account_number_encrypted String?
  account_digit_encrypted  String?
  pix_key_encrypted        String?
  document_encrypted       String?
  account_fingerprint      String?
  account_last4            String?
  pix_key_last4            String?
  encryption_key_version   String?
  currency                 String                 @default("BRL")
  opening_balance_cents    BigInt                 @default(0)
  opening_balance_date     DateTime?
  allows_negative_balance  Boolean                @default(false)
  is_cash_equivalent       Boolean                @default(false)
  is_active                Boolean                @default(true)
  notes                    String?
  created_by_admin_id      String?
  updated_by_admin_id      String?
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt

  created_by_admin admins? @relation("financial_accounts_created_by", fields: [created_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updated_by_admin admins? @relation("financial_accounts_updated_by", fields: [updated_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  transactions_as_account financial_transactions[] @relation("FinancialTransactionAccount")
  transactions_as_counterparty financial_transactions[] @relation("FinancialTransactionCounterpartyAccount")

  @@unique([code])
  @@index([type, is_active])
  @@index([currency])
  @@map("financial_accounts")
}

model financial_categories {
  id                    String                  @id @default(uuid())
  code                  String
  name                  String
  kind                  financial_category_kind
  parent_id             String?
  default_direction     financial_direction?
  requires_document     Boolean                 @default(false)
  is_system             Boolean                 @default(false)
  is_active             Boolean                 @default(true)
  is_postable           Boolean
  sort_order            Int                     @default(0)
  accounting_code       String?
  accounting_nature     accounting_nature_type?
  dre_group             String?
  balance_sheet_group   String?
  fiscal_classification String?
  deductible            Boolean?
  export_code           String?
  accountant_notes      String?
  created_by_admin_id   String?
  updated_by_admin_id   String?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt

  parent           financial_categories?  @relation("financial_categories_hierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children         financial_categories[] @relation("financial_categories_hierarchy")
  created_by_admin admins?                @relation("financial_categories_created_by", fields: [created_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updated_by_admin admins?                @relation("financial_categories_updated_by", fields: [updated_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  financial_transactions financial_transactions[]
  financial_transaction_allocations financial_transaction_allocations[]

  @@unique([code])
  @@index([kind, is_active])
  @@index([parent_id])
  @@index([sort_order])
  @@map("financial_categories")
}

model financial_cost_centers {
  id                  String                     @id @default(uuid())
  code                String
  name                String
  type                financial_cost_center_type
  parent_id           String?
  territory_id        String?
  city                String?
  state               String?
  is_active           Boolean                    @default(true)
  created_by_admin_id String?
  updated_by_admin_id String?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt

  parent               financial_cost_centers?          @relation("financial_cost_centers_hierarchy", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children             financial_cost_centers[]         @relation("financial_cost_centers_hierarchy")
  territory            operational_territories?         @relation("financial_cost_centers_territory", fields: [territory_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recognition_policies financial_recognition_policies[] @relation("financial_recognition_policies_cost_center")
  created_by_admin     admins?                          @relation("financial_cost_centers_created_by", fields: [created_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updated_by_admin     admins?                          @relation("financial_cost_centers_updated_by", fields: [updated_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  financial_transactions financial_transactions[]
  financial_transaction_allocations financial_transaction_allocations[]

  @@unique([code])
  @@index([type, is_active])
  @@index([parent_id])
  @@index([territory_id])
  @@index([city, state])
  @@map("financial_cost_centers")
}

model financial_transactions {
  id                      String                        @id @default(uuid())
  external_reference      String?
  provider                String?
  provider_event_id       String?
  source_type             financial_source_type
  source_id               String?
  origin_type             financial_origin_type
  origin_id               String?

  account_id              String
  counterparty_account_id String?
  category_id             String?
  cost_center_id          String?
  transfer_group_id       String?

  direction               financial_direction
  transaction_type        financial_transaction_type
  status                  financial_transaction_status @default(DRAFT)
  payment_method          financial_payment_method?
  recognition_policy      financial_recognition_policy?

  competence_date         DateTime
  transaction_date        DateTime
  due_date                DateTime?
  settlement_date         DateTime?

  gross_amount_cents      BigInt
  fee_amount_cents        BigInt                       @default(0)
  discount_amount_cents   BigInt                       @default(0)
  retention_amount_cents  BigInt                       @default(0)
  net_amount_cents        BigInt
  transfer_amount_cents   BigInt?

  reversal_of_id          String?
  canceled_reason         String?
  canceled_at             DateTime?

  description             String
  memo                    String?
  metadata                Json?
  idempotency_key         String?                      @unique

  created_by_admin_id     String?
  approved_by_admin_id    String?
  responsible_admin_id    String?

  created_at              DateTime                     @default(now())
  updated_at              DateTime                     @updatedAt

  account                 financial_accounts           @relation("FinancialTransactionAccount", fields: [account_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  counterparty_account    financial_accounts?          @relation("FinancialTransactionCounterpartyAccount", fields: [counterparty_account_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category                financial_categories?        @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cost_center             financial_cost_centers?      @relation(fields: [cost_center_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reversal_of             financial_transactions?      @relation("FinancialTransactionReversal", fields: [reversal_of_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reversals               financial_transactions[]     @relation("FinancialTransactionReversal")
  created_by_admin        admins?                      @relation("FinancialTransactionCreatedBy", fields: [created_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approved_by_admin       admins?                      @relation("FinancialTransactionApprovedBy", fields: [approved_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  responsible_admin       admins?                      @relation("FinancialTransactionResponsible", fields: [responsible_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  allocations             financial_transaction_allocations[]
  outgoing_links          financial_transaction_links[] @relation("FinancialTransactionLinkSource")
  incoming_links          financial_transaction_links[] @relation("FinancialTransactionLinkTarget")

  @@index([account_id, transaction_date])
  @@index([counterparty_account_id])
  @@index([category_id, competence_date])
  @@index([cost_center_id, competence_date])
  @@index([status, direction])
  @@index([source_type, source_id])
  @@index([provider, provider_event_id])
  @@index([origin_type, origin_id])
  @@index([transfer_group_id])
  @@index([reversal_of_id])
  @@index([created_by_admin_id])
  @@index([approved_by_admin_id])
  @@index([responsible_admin_id])
  @@map("financial_transactions")
}

model financial_transaction_allocations {
  id                  String                              @id @default(uuid())
  transaction_id      String
  category_id         String
  cost_center_id      String?
  amount_cents        BigInt
  allocation_type     financial_transaction_allocation_type
  description         String?
  metadata            Json?
  created_by_admin_id String?
  created_at          DateTime                            @default(now())
  updated_at          DateTime                            @updatedAt

  transaction         financial_transactions              @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category            financial_categories                @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cost_center         financial_cost_centers?            @relation(fields: [cost_center_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_by_admin    admins?                             @relation("FinancialTransactionAllocationCreatedBy", fields: [created_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([transaction_id])
  @@index([category_id])
  @@index([cost_center_id])
  @@index([allocation_type])
  @@index([created_by_admin_id])
  @@map("financial_transaction_allocations")
}

model financial_transaction_links {
  id                    String                        @id @default(uuid())
  transaction_id        String
  linked_transaction_id String
  link_type             financial_transaction_link_type
  amount_cents          BigInt?
  metadata              Json?
  created_by_admin_id   String?
  created_at            DateTime                      @default(now())
  updated_at            DateTime                      @updatedAt

  transaction           financial_transactions        @relation("FinancialTransactionLinkSource", fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  linked_transaction    financial_transactions        @relation("FinancialTransactionLinkTarget", fields: [linked_transaction_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_by_admin      admins?                       @relation("FinancialTransactionLinkCreatedBy", fields: [created_by_admin_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([transaction_id, linked_transaction_id, link_type])
  @@index([link_type])
  @@index([linked_transaction_id])
  @@index([created_by_admin_id])
  @@map("financial_transaction_links")
}

model operational_insurance_coverages {
  id                      String   @id @default(uuid())
  territory_id            String?
  modality                String   @db.VarChar(30) // CAR_PASSENGER | MOTO_PASSENGER | MOTO_DELIVERY
  provider_name           String   @db.VarChar(200)
  policy_number           String   @db.VarChar(120)
  coverage_type           String   @db.VarChar(30) // APP | RC_F | PERSONAL_ACCIDENT | CARGO | OTHER
  coverage_description    String?
  coverage_amount_death   Decimal? @db.Decimal(12, 2)
  coverage_amount_disability Decimal? @db.Decimal(12, 2)
  coverage_amount_medical Decimal? @db.Decimal(12, 2)
  valid_from              DateTime @db.Date
  valid_until             DateTime @db.Date
  status                  String   @default("DRAFT") @db.VarChar(20) // DRAFT | ACTIVE | EXPIRED | SUSPENDED
  document_url            String?
  notes                   String?
  created_by_admin_id     String?
  updated_by_admin_id     String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  territory               operational_territories? @relation(fields: [territory_id], references: [id], onDelete: SetNull)
  created_by_admin        admins? @relation("insurance_coverages_created_by", fields: [created_by_admin_id], references: [id], onDelete: SetNull)
  updated_by_admin        admins? @relation("insurance_coverages_updated_by", fields: [updated_by_admin_id], references: [id], onDelete: SetNull)

  @@index([territory_id])
  @@index([modality])
  @@index([status])
  @@index([valid_until])
}

model moto_passenger_compliance {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  territory_id          String    @unique
  municipality_name     String?   @db.VarChar(200)
  consultation_date     DateTime? @db.Date
  consulted_by_admin_id String?
  prefecture_notes      String?
  protocol_number       String?   @db.VarChar(100)
  document_url          String?
  status                String    @default("PENDING") @db.VarChar(20)
  approved_by_admin_id  String?
  approved_at           DateTime?

  @@index([territory_id])
  @@index([manager_id])
  @@index([status])
  @@index([reference_month])
}

model territory_cycle_allocations {
  id                    String   @id @default(dbgenerated("gen_random_uuid()"))
  cycle_id              String
  ledger_entry_id       BigInt
  ride_id               String
  entry_type            String
  amount_cents          BigInt
  manager_assignment_id String?
  created_at            DateTime @default(now()) @db.Timestamptz

  cycle                 territory_payout_cycles @relation(fields: [cycle_id], references: [id], onDelete: Restrict)
  ledger_entry          territory_ledger        @relation(fields: [ledger_entry_id], references: [id], onDelete: Restrict)

  @@unique([ledger_entry_id])
  @@index([cycle_id])
}

// ═══════════════════════════════════════════════════════════════════
// Portal do Contador — Frente 1: Base Entities
// ═══════════════════════════════════════════════════════════════════

enum legal_entity_type {
  MATRIZ
  FILIAL
}

enum accounting_firm_document_type {
  CNPJ
  CPF
}

enum accountant_status {
  INVITED
  ACTIVE
  SUSPENDED
  BLOCKED
  REVOKED
}

enum accountant_invite_status {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum accountant_link_status {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum accountant_link_scope {
  FISCAL
  CONTABIL
  FOLHA
  SOCIETARIO
  FINANCEIRO
  MUNICIPAL
  COMPLETO
}

model legal_entities {
  id                String              @id @default(uuid())
  razao_social      String
  nome_fantasia     String?
  cnpj              String              @unique
  entity_type       legal_entity_type
  parent_entity_id  String?
  uf                String?             @db.VarChar(2)
  municipio         String?
  endereco          String?
  codigo_interno    String?             @unique
  is_active         Boolean             @default(true)

  // Institutional fields
  data_abertura           DateTime?           @db.Date
  situacao_cadastral      String?             @db.VarChar(20)
  data_situacao_cadastral DateTime?           @db.Date
  porte                   String?             @db.VarChar(10)
  natureza_juridica       String?
  capital_social_cents    BigInt?
  email_institucional     String?
  telefone_institucional  String?
  whatsapp_institucional  String?
  site                    String?
  logradouro              String?
  numero                  String?
  complemento             String?
  bairro                  String?
  cep                     String?             @db.VarChar(10)
  cnae_principal          String?
  cnaes_secundarios       String[]            @default([])

  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  parent            legal_entities?     @relation("LegalEntityHierarchy", fields: [parent_entity_id], references: [id])
  children          legal_entities[]    @relation("LegalEntityHierarchy")
  accountant_links  accountant_entity_links[]
  persons           legal_entity_persons[]

  @@index([parent_entity_id])
  @@index([entity_type])
  @@index([is_active])
  company_documents   accounting_company_documents[]
  certificates        accounting_certificates[]          @relation("entity_certificates")
  powers_of_attorney  accounting_powers_of_attorney[]    @relation("entity_powers_of_attorney")
  payment_obligations accounting_payment_obligations[]   @relation("entity_obligations")
  competencies        accounting_competencies[]           @relation("entity_competencies")
  recurring_templates accounting_recurring_templates[]    @relation("entity_recurring_templates")
  automation_config   accounting_automation_config?       @relation("entity_automation_config")
  automation_log      accounting_automation_log[]         @relation("entity_automation_log")
  @@map("legal_entities")
}

model legal_entity_persons {
  id                String   @id @default(uuid())
  entity_id         String
  nome              String
  funcao            String
  funcao_origem     String   @default("INTERNAL")
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  entity            legal_entities @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@unique([entity_id, nome, funcao])
  @@index([entity_id, is_active])
  @@map("legal_entity_persons")
}

model accounting_firms {
  id                String                         @id @default(uuid())
  razao_social      String
  nome_fantasia     String?
  document_type     accounting_firm_document_type
  document_number   String                         @unique
  crc               String?
  crc_uf            String?                        @db.VarChar(2)
  email             String
  telefone          String?
  is_active         Boolean                        @default(true)
  created_at        DateTime                       @default(now())
  updated_at        DateTime                       @updatedAt

  accountants       accountants[]

  @@index([is_active])
  @@map("accounting_firms")
}

model accountants {
  id                          String             @id @default(uuid())
  accounting_firm_id          String
  nome_completo               String
  email                       String             @unique
  cpf                         String             @unique
  crc                         String?
  crc_uf                      String?            @db.VarChar(2)
  job_title                   String?
  department                  String?
  is_responsible_accountant   Boolean            @default(false)
  status                      accountant_status  @default(INVITED)
  is_active                   Boolean            @default(true)
  mfa_enabled                 Boolean            @default(false)
  password_hash               String?
  password_changed_at         DateTime?
  password_version            Int                @default(1)
  failed_login_count          Int                @default(0)
  locked_until                DateTime?
  last_login_at               DateTime?
  terms_accepted_at           DateTime?
  invited_at                  DateTime?
  activated_at                DateTime?
  created_at                  DateTime           @default(now())
  updated_at                  DateTime           @updatedAt

  firm                accounting_firms   @relation(fields: [accounting_firm_id], references: [id])
  invites             accountant_invites[]
  entity_links        accountant_entity_links[]
  sessions            accountant_sessions[]
  password_resets     accountant_password_resets[]

  @@index([accounting_firm_id])
  @@index([status])
  @@index([is_active])
  doc_files_uploaded  accounting_company_document_files[] @relation("doc_file_uploader_accountant")
  certificates_responsible  accounting_certificates[]          @relation("cert_responsible")
  poa_responsible           accounting_powers_of_attorney[]    @relation("poa_responsible")
  obligations_created       accounting_payment_obligations[]   @relation("obligation_creator")
  obligations_verified      accounting_payment_obligations[]   @relation("obligation_verifier")
  obligation_tokens_created accounting_obligation_access_tokens[] @relation("token_creator")
  competencies_responsible  accounting_competencies[]              @relation("comp_responsible")
  competencies_completed    accounting_competencies[]              @relation("comp_completed_by")
  competencies_created      accounting_competencies[]              @relation("comp_created_by")
  competency_doc_links      accounting_competency_documents[]      @relation("comp_doc_linker")
  recurring_templates       accounting_recurring_templates[]       @relation("rt_creator")
  @@map("accountants")
}

model accountant_invites {
  id                  String                    @id @default(uuid())
  accountant_id       String
  token_hash          String
  status              accountant_invite_status  @default(PENDING)
  expires_at          DateTime
  accepted_at         DateTime?
  revoked_at          DateTime?
  created_by_admin_id String
  resent_count        Int                       @default(0)
  last_sent_at        DateTime?
  revoked_by_admin_id String?
  accepted_ip         String?
  accepted_user_agent String?
  last_email_sent_at  DateTime?
  last_email_status   String?
  last_email_error    String?
  last_email_log_id   String?
  created_at          DateTime                  @default(now())

  accountant          accountants               @relation(fields: [accountant_id], references: [id])
  created_by_admin    admins                    @relation("invite_creator", fields: [created_by_admin_id], references: [id])
  revoked_by_admin    admins?                   @relation("invite_revoker", fields: [revoked_by_admin_id], references: [id])

  @@index([accountant_id])
  @@index([status])
  @@map("accountant_invites")
}

model accountant_entity_links {
  id                      String                  @id @default(uuid())
  accountant_id           String
  legal_entity_id         String
  scope                   accountant_link_scope
  can_view                Boolean                 @default(true)
  can_upload              Boolean                 @default(false)
  can_download            Boolean                 @default(true)
  can_request_correction  Boolean                 @default(false)
  can_mark_processed      Boolean                 @default(false)
  can_close_period        Boolean                 @default(false)
  inherits_children       Boolean                 @default(false)
  is_primary              Boolean                 @default(false)
  starts_at               DateTime
  ends_at                 DateTime?
  status                  accountant_link_status  @default(ACTIVE)
  created_by_admin_id     String
  created_at              DateTime                @default(now())
  updated_at              DateTime                @updatedAt

  accountant              accountants             @relation(fields: [accountant_id], references: [id])
  legal_entity            legal_entities          @relation(fields: [legal_entity_id], references: [id])
  created_by_admin        admins                  @relation("link_creator", fields: [created_by_admin_id], references: [id])

  // Partial unique index managed via raw SQL migration (uq_active_link)
  @@index([accountant_id])
  @@index([legal_entity_id])
  @@index([status])
  @@index([starts_at, ends_at])
  @@map("accountant_entity_links")
}

enum accountant_session_status {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
  COMPROMISED
}

enum accountant_reset_status {
  PENDING
  USED
  EXPIRED
  REVOKED
}

model accountant_sessions {
  id                  String                       @id @default(uuid())
  accountant_id       String
  token_family_id     String
  refresh_token_hash  String
  generation          Int                          @default(1)
  parent_session_id   String?
  replaced_by_id      String?
  status              accountant_session_status    @default(ACTIVE)
  scope               String                       @default("WEB")
  device_name         String?
  ip_address          String?
  user_agent          String?
  created_ip          String?
  last_activity_at    DateTime?
  created_at          DateTime                     @default(now())
  expires_at          DateTime
  rotated_at          DateTime?
  revoked_at          DateTime?
  revocation_reason   String?
  reuse_detected_at   DateTime?

  accountant          accountants                  @relation(fields: [accountant_id], references: [id], onDelete: Cascade)

  @@index([accountant_id, status])
  @@index([token_family_id, status])
  @@index([refresh_token_hash])
  @@map("accountant_sessions")
}

model accountant_password_resets {
  id                  String                   @id @default(uuid())
  accountant_id       String
  token_hash          String
  status              accountant_reset_status  @default(PENDING)
  expires_at          DateTime
  requested_ip        String?

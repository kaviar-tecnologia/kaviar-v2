{
  "name": "kaviar-backend",
  "version": "1.0.0",
  "description": "KAVIAR Backend - Sistema de Corridas Comunitárias",
  "main": "dist/server.js",
  "scripts": {
    "dev": "dotenv -e .env.development -- tsx watch src/server.ts",
    "test": "vitest run",
    "test:finance-reversal:integration": "RUN_FINANCE_REVERSAL_INTEGRATION=1 vitest run tests/admin-finance-reversal.integration.test.ts",
    "test:finance-atomic-audit:integration": "RUN_FINANCE_ATOMIC_AUDIT_INTEGRATION=1 vitest run tests/admin-finance-atomic-audit.integration.test.ts",
    "test:accountant-manual:integration": "RUN_ACCOUNTANT_MANUAL_INTEGRATION=1 vitest run tests/admin-accountant-manual-transactions.integration.test.ts",
    "dev:3003": "dotenv -e .env.development -- tsx watch src/server.ts",
    "build": "./node_modules/.bin/tsc -p tsconfig.build.json",
    "postbuild": "mkdir -p dist/scripts && cp scripts/beta-monitor-dog.js dist/scripts/ && cp scripts/beta-phase1-checkpoint.sh dist/scripts/ && cp scripts/beta-phase1-go-nogo.sh dist/scripts/ && cp scripts/beta-phase2-activate.sh dist/scripts/ && cp scripts/update-rollout.js dist/scripts/ && cp scripts/check-rollout.js dist/scripts/ && cp scripts/promote-premium-tourism.js dist/scripts/",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "start:3003": "PORT=3003 node dist/server.js",
    "kill:ports": "pkill -f 'tsx.*server.ts' || pkill -f 'node.*server.js' || lsof -ti:3001,3003 | xargs -r kill -9 || true",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "tsx scripts/validate-db.ts",
    "seed:drivers": "NODE_ENV=development tsx prisma/seed-drivers.ts",
    "finance:accounts:validate": "tsx scripts/finance/validate-account-blueprint.ts",
    "finance:accounts:plan": "tsx scripts/finance/plan-account-materialization.ts",
    "finance:accounts:materialize:local": "tsx scripts/finance/materialize-account-blueprint-local.ts",
    "finance:decisions:validate": "tsx scripts/finance/validate-decision-register.ts",
    "finance:decisions:generate": "tsx scripts/finance/generate-decision-docs.ts",
    "finance:decisions:check": "tsx scripts/finance/check-decision-docs.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.978.0",
    "@aws-sdk/client-ses": "^3.982.0",
    "@aws-sdk/client-sns": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.978.0",
    "@prisma/client": "^5.22.0",
    "@turf/boolean-point-in-polygon": "^7.3.1",
    "@turf/helpers": "^7.3.1",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "13.8.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "nodemailer": "^6.10.1",
    "node-fetch": "^3.3.2",
    "pdfkit": "0.15.1",
    "pg": "^8.18.0",
    "twilio": "^5.11.2",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer-s3": "^3.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.7.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

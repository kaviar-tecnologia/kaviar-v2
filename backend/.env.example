# Environment
NODE_ENV=development
PORT=3001

# Database - Neon PostgreSQL
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/database?sslmode=require&connection_limit=2&pool_timeout=20&connect_timeout=10"

# JWT
JWT_SECRET=REDACTED
JWT_RESET_SECRET=REDACTED_SEPARATE_SECRET
JWT_EXPIRES_IN=24h

# Admin
ADMIN_DEFAULT_EMAIL=admin@kaviar.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ON_FIRST_DEPLOY

# Rate Limiting
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_LIMIT_PER_EMAIL=5

# Driver Governance (Feature Flags)
ENABLE_DRIVER_APPROVAL_GATES=false

# Email transacional (Cloudflare SMTP)
EMAIL_PROVIDER=cloudflare
EMAIL_FROM_DEFAULT="KAVIAR <no-reply@kaviar.com.br>"
EMAIL_REPLY_TO=contato@kaviar.com.br
CLOUDFLARE_SMTP_HOST=smtp.mx.cloudflare.net
CLOUDFLARE_SMTP_PORT=465
CLOUDFLARE_SMTP_SECURE=true
CLOUDFLARE_SMTP_USER=api_token
CLOUDFLARE_SMTP_TOKEN=
# Legado opcional (somente se EMAIL_PROVIDER=ses)
AWS_REGION=us-east-2
# Opcional: aliases extras permitidos, separados por virgula
EMAIL_ALLOWED_FROM=contato@kaviar.com.br,suporte@kaviar.com.br,financeiro@kaviar.com.br,no-reply@kaviar.com.br
# Destinatarios permitidos para endpoint de teste /api/admin/email/test
EMAIL_TEST_ALLOWED_TO=contato@kaviar.com.br,aparecido.goes@gmail.com
# Fallback da allowlist de teste quando EMAIL_TEST_ALLOWED_TO nao for definido
FORWARD_TO_EMAIL=

# Geofence (Feature Flags)
ENABLE_GEOFENCE=false
FALLBACK_WAIT_SECONDS=0
GEOFENCE_LOCATION_VALIDITY=5

# Driver Enforcement (Feature Flags)
ENABLE_DRIVER_ENFORCEMENT_GATES=false

# Diamond System (Feature Flags)
ENABLE_DIAMOND=false
DIAMOND_BONUS_FIXED=5.00
DIAMOND_BONUS_DAILY_CAP=25.00

# Rating System (Feature Flags)
ENABLE_RATING_SYSTEM=false
RATING_WINDOW_DAYS=7
RATING_COMMENT_MAX_LENGTH=200

# Premium Tourism (Feature Flags)
ENABLE_PREMIUM_TOURISM=false
MIN_RATING_PREMIUM=4.7
MIN_RATINGS_COUNT_PREMIUM=20

# Twilio Base (obrigatório)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Templates (HX / Content API)
TWILIO_WHATSAPP_ENABLED=true
TWILIO_WHATSAPP_FROM=whatsapp:+5521968648777

# Verify VOICE (número Twilio BR)
TWILIO_VERIFY_VOICE_ENABLED=true
TWILIO_VERIFY_VOICE_NUMBER=+552123915686
TWILIO_VERIFY_VOICE_WEBHOOK_PATH=/api/twilio/verify-voice
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14134759634

# Legacy APIs (Feature Flags)
ENABLE_LEGACY=false

# Admin Alert SMS (novo contato WhatsApp)
ADMIN_ALERT_ENABLED=true
ADMIN_ALERT_PHONE=+5521980669989
ADMIN_ALERT_SMS_FROM=+14134759634
ADMIN_ALERT_DRY_RUN=true

# WhatsApp Template SIDs (Twilio Content API)
WA_TPL_OPS_DRIVER_ALERT=
WA_TPL_DRIVER_COMPLETED_V1=
WA_TPL_DRIVER_COMPLETED_V2=
WA_TPL_PASSENGER_ARRIVING=
WA_TPL_RIDES_STARTED=
WA_TPL_RIDES_CANCELLED=
WA_TPL_PASSENGER_CANCELLED=
WA_TPL_DEST_CHANGED=
WA_TPL_DRIVER_ASSIGNED_V1=
WA_TPL_PASSENGER_DRIVER_ASSIGNED_V2=
WA_TPL_DRIVER_CANCELLED=
WA_TPL_PASSENGER_COMPLETED=
WA_TPL_INVITE_DRIVER=
WA_TPL_INVITE_INVESTOR=
WA_TPL_DRIVER_ARRIVED=
WA_TPL_PAYMENT_RECEIPT=
WA_TPL_CONSULTANT_WELCOME=
WA_TPL_PASSWORD_RESET=
WA_TPL_VERIFICATION_CODE=

# Payments - Asaas (fallback atual)
ASAAS_BASE_URL=
ASAAS_API_KEY=

# Payments - SumUp (provider alternativo)
# Use SUMUP_ENABLED=true somente quando quiser testar/ativar fluxo com provider=sumup
SUMUP_BASE_URL=https://api.sumup.com
SUMUP_API_KEY=
SUMUP_PUBLIC_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_ENABLED=false
SUMUP_WEBHOOK_TOKEN=
SUMUP_RECONCILE_TOKEN=
SUMUP_RECONCILE_SCHEDULER_ENABLED=false
SUMUP_RECONCILE_INTERVAL_MS=300000
SUMUP_RECONCILE_BATCH_LIMIT=20

# Insurance - Previlemos
# Manter false até concluir homologação.
PREVILEMOS_ENABLED=false

# HML e PRD devem usar URLs/credenciais próprias.
PREVILEMOS_BASE_URL=
PREVILEMOS_USERNAME=
PREVILEMOS_PASSWORD=

# Parâmetros contratuais atuais
PREVILEMOS_TABLE="63C 1"
PREVILEMOS_INSURED_AMOUNT=30000
PREVILEMOS_VEHICLE_TYPE=16
